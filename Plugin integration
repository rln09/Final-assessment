FOR EXPIRED SPECIALS AND SCHEDULING
add_action('wp_scheduled_posts', function() {
    $expired = get_posts([
        'post_type' => 'weekly_special',
        'meta_query' => [[
            'key' => 'end_date',
            'value' => date('Y-m-d'),
            'compare' => '<',
            'type' => 'DATE'
        ]]
    ]);
    foreach ($expired as $post) {
        wp_update_post(['ID' => $post->ID, 'post_status' => 'draft']);
    }
});

